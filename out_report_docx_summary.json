      ]
    },
    {
      "index": 20,
      "rows": 1,
      "cols": 1,
      "first_row": [
        "ℒ_LP = −Σ_{(i,j)∈E} log ŝᵢⱼ − Σ_{(i,k)∉E} log(1 − ŝᵢₖ)"
      ]
    },
    {
      "index": 21,
      "rows": 1,
      "cols": 1,
      "first_row": [
        "ℒ_EMB = −Σ_{(vᵢ,vⱼ)∈E} log σ(z^T_i z_j) − Q · E_{vₙ~Pₙ}[log σ(−z^T_i z_n)]"
      ]
    },
    {
      "index": 22,
      "rows": 1,
      "cols": 1,
      "first_row": [
        "ℒ_NC = −(1/|V_L|) Σ_{vᵢ ∈ V_L} Σ_{c=1}^{C} yᵢc log ŷᵢc"
      ]
    },
    {
      "index": 23,
      "rows": 1,
      "cols": 1,
      "first_row": [
        "z_G = READOUT({h^(L)_i}_{vᵢ ∈ V}) = (1/|V|) Σ_{vᵢ ∈ V} h^(L)_i"
      ]
    },
    {
      "index": 24,
      "rows": 1,
      "cols": 1,
      "first_row": [
        "ŝᵢⱼ = σ( z^T_i · z_j )"
      ]
    },
    {
      "index": 25,
      "rows": 1,
      "cols": 1,
      "first_row": [
        "ℒ_LP = −Σ_{(i,j)∈E} log ŝᵢⱼ − Σ_{(i,k)∉E} log(1 − ŝᵢₖ)"
      ]
    },
    {
      "index": 26,
      "rows": 1,
      "cols": 1,
      "first_row": [
        "Q = (1/2m) Σ_{i,j} [ Aᵢⱼ − kᵢkⱼ/(2m) ] δ(cᵢ, cⱼ)"
      ]
    },
    {
      "index": 27,
      "rows": 1,
      "cols": 1,
      "first_row": [
        "ℒ_EMB = −Σ_{(vᵢ,vⱼ) ∈ E} log P(vⱼ | vᵢ)"
      ]
    },
    {
      "index": 28,
      "rows": 1,
      "cols": 1,
      "first_row": [
        "P(vⱼ | vᵢ) = exp(z^T_i z_j) / Σ_k exp(z^T_i z_k)"
      ]
    },
    {
      "index": 29,
      "rows": 1,
      "cols": 1,
      "first_row": [
        "ℒ_VGAE = E_q[log p(A|Z)] − KL[q(Z|X,A) || p(Z)]"
      ]
    },
    {
      "index": 30,
      "rows": 1,
      "cols": 1,
      "first_row": [
        "Σ = (1/n) Z^T Z → Z_2D = Z W_2"
      ]
    },
    {
      "index": 31,
      "rows": 1,
      "cols": 1,
      "first_row": [
